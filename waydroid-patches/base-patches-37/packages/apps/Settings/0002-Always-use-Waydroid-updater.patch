From b61a6b4e7f5c0a8f328da245e2de72cb9479def0 Mon Sep 17 00:00:00 2001
From: SupeChicken666 <me@supechicken666.dev>
Date: Sun, 23 Aug 2026 04:05:09 +0000
Subject: [PATCH 2/2] Always use Waydroid updater

Change-Id: I8c3842554f64a2ae9c87ab79c020c7fe9d6c4769
Signed-off-by: SupeChicken666 <me@supechicken666.dev>
---
 res/xml/system_dashboard_fragment.xml                     | 4 +++-
 src/com/android/settings/system/SystemUpdateRepository.kt | 7 +------
 2 files changed, 4 insertions(+), 7 deletions(-)

diff --git a/res/xml/system_dashboard_fragment.xml b/res/xml/system_dashboard_fragment.xml
index 3dae93a..97c3569 100644
--- a/res/xml/system_dashboard_fragment.xml
+++ b/res/xml/system_dashboard_fragment.xml
@@ -42,7 +42,9 @@
             android:icon="@drawable/ic_system_update"
             settings:keywords="@string/keywords_system_update_settings"
             settings:controller="com.android.settings.system.SystemUpdatePreferenceController">
-            <intent android:action="android.settings.SYSTEM_UPDATE_SETTINGS"/>
+            <intent android:action="android.intent.action.MAIN"
+                    android:targetPackage="org.lineageos.waydroidupdater"
+                    android:targetClass="org.lineageos.waydroidupdater.UpdateActivity"/>
         </Preference>
     </PreferenceCategory>
 
diff --git a/src/com/android/settings/system/SystemUpdateRepository.kt b/src/com/android/settings/system/SystemUpdateRepository.kt
index f8804be..e11ee3d 100644
--- a/src/com/android/settings/system/SystemUpdateRepository.kt
+++ b/src/com/android/settings/system/SystemUpdateRepository.kt
@@ -28,11 +28,6 @@ class SystemUpdateRepository(context: Context) {
      * Finds a matching activity for the system update intent.
      */
     fun getSystemUpdateIntent(): Intent? {
-        val intent = Intent(Settings.ACTION_SYSTEM_UPDATE_SETTINGS)
-        return packageManager.resolveActivity(intent, PackageManager.MATCH_SYSTEM_ONLY)
-            ?.activityInfo
-            ?.let { activityInfo ->
-                Intent().setClassName(activityInfo.packageName, activityInfo.name)
-            }
+        return Intent().setClassName("org.lineageos.waydroidupdater", "org.lineageos.waydroidupdater.UpdateActivity")
     }
 }
-- 

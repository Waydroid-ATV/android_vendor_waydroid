+++ b/media/libstagefright/xmlparser/include/media/stagefright/xmlparser/MediaCodecsXmlParser.h
@@ -39,6 +39,8 @@ public:
     // /vendor/etc.
     static std::vector<std::string> getDefaultSearchDirs() {
         return { "/product/etc",
